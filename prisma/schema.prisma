generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Configuracion {
  id                        Int      @id @default(autoincrement())
  costo_indirecto           Float    @default(0.10)
  porcentaje_administrativo Float    @default(0.17)
  rentabilidad              Float    @default(0.30)
  updatedAt                 DateTime @updatedAt
}

model Usuario {
  id                          Int                  @id @default(autoincrement())
  nombre                      String
  nombreComercial             String?
  email                       String               @unique
  password                    String?
  role                        Rol
  marca                       Marca                @default(ZAAZMAGO)
  activo                      Boolean              @default(true)
  activationToken             String?              @unique
  activationExpires           DateTime?
  createdAt                   DateTime             @default(now())
  cliente                     Cliente?
  cotizaciones                Cotizacion[]
  metas                       MetaMensual[]
  solicitudesMargen           SolicitudMargen[]    @relation("SolicitudesCreadas")
  solicitudesResueltas        SolicitudMargen[]    @relation("SolicitudesResueltas")
  cotizacionLogs              CotizacionLog[]
  metaLogs                    MetaMensualLog[]     @relation("MetaLogVendedor")
  metaLogsCambios             MetaMensualLog[]     @relation("MetaLogAdmin")
  logsComoSujeto              UsuarioLog[]         @relation("LogsDeUsuario")
  logsRealizados              UsuarioLog[]         @relation("LogsRealizados")
  panelWidgets                PanelWidget[]
  movimientosAlmacen          MovimientoAlmacen[]
  ordenesAlmacen              OrdenAlmacen[]
  ordenesCompraCreadas        OrdenCompra[]        @relation("OrdenCompraCreador")
  ordenesCompraAprobadas      OrdenCompra[]        @relation("OrdenCompraAprobador")
  proyectosComoGerente        Proyecto[]           @relation("ProyectoGerenteResponsable")
  proyectosComoJefe           Proyecto[]           @relation("ProyectoJefeResponsable")
  solicitudesAlmacenResueltas SolicitudAlmacen[]
  comprobantes                Comprobante[]
  pagosComprobante            PagoComprobante[]
  cuentasPorPagar             CuentaPorPagar[]
  pagosCuentaPorPagar         PagoCuentaPorPagar[]
  adjuntosPago                AdjuntoPago[]
}

// Acomodo personal del panel de bienvenida (bento): qué bloques tiene cada
// usuario, dónde y de qué tamaño. "kind" identifica el bloque (un módulo como
// "outdoor", o un submódulo puntual como "outdoor.rentabilidad").
model PanelWidget {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  kind      String
  x         Int
  y         Int
  w         Int
  h         Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, kind])
}

model Cliente {
  id                 Int                 @id @default(autoincrement())
  nombreComercial    String
  documento          String              @unique
  nombreContacto     String
  telefono           String?
  email              String?
  direccion          String?
  activo             Boolean             @default(true)
  // Condición de pago por defecto: CONTADO, o CREDITO a diasCredito días.
  // La cotización la hereda (y puede cambiarla) y la factura la trae precargada.
  condicionPago      String              @default("CONTADO")
  diasCredito        Int?
  createdAt          DateTime            @default(now())
  usuarioId          Int?                @unique
  usuario            Usuario?            @relation(fields: [usuarioId], references: [id])
  cotizaciones       Cotizacion[]
  reservas           Reserva[]
  solicitudesMargen  SolicitudMargen[]
  movimientosAlmacen MovimientoAlmacen[]
  ordenesAlmacen     OrdenAlmacen[]
  proyectos          Proyecto[]
  comprobantes       Comprobante[]
}

model Producto {
  id              Int                 @id @default(autoincrement())
  categoria       String
  servicio        String
  material        String?
  unidad          String?
  costo_material  Float
  costo_parcial_1 Float
  costo_parcial_2 Float
  precio_final    Float
  margen          Float
  activo          Boolean             @default(true)
  origen          String              @default("CSV")
  tipoMedida      TipoMedida          @default(UNIDAD)
  nombre          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           CotizacionItem[]
  adicionales     ProductoAdicional[]

  @@index([categoria])
  @@index([servicio])
}

model ProductoAdicional {
  id         Int                   @id @default(autoincrement())
  nombre     String
  precio     Float
  productoId Int
  items      CotizacionAdicional[]
  producto   Producto              @relation(fields: [productoId], references: [id])
}

model Cotizacion {
  id                   Int               @id @default(autoincrement())
  numero               String            @unique
  total                Float
  conIgv               Boolean           @default(true)
  estado               EstadoCotizacion  @default(PENDIENTE)
  createdAt            DateTime          @default(now())
  respondidaAt         DateTime?
  respuestaComentario  String?
  facturadaAt          DateTime?
  // Condición de pago pactada (copiada del cliente al crearla, editable).
  condicionPago        String            @default("CONTADO")
  diasCredito          Int?
  proyectoExternoId    String?
  proyectoExternoError String?
  // Cuentas de la empresa elegidas para que el cliente pague (copia de
  // CuentaFinanciera al guardar): [{ id, nombre, tipo, banco, numero, cci, moneda }]
  cuentasBancarias     Json?
  clienteId            Int
  usuarioId            Int
  cliente              Cliente           @relation(fields: [clienteId], references: [id])
  usuario              Usuario           @relation(fields: [usuarioId], references: [id])
  items                CotizacionItem[]
  log                  CotizacionLog[]
  reservas             Reserva[]
  solicitudesMargen    SolicitudMargen[]
  proyecto             Proyecto?
  comprobantes         Comprobante[]
  // NETWISE: cotización del módulo Netwise (servicios de agencia, numeración
  // NW-año-n, PDF con su marca). Se cobra y factura igual, por Zaazmago.
  marca                Marca             @default(ZAAZMAGO)
}

model CotizacionLog {
  id             Int               @id @default(autoincrement())
  cotizacionId   Int
  usuarioId      Int
  estadoAnterior EstadoCotizacion?
  estadoNuevo    EstadoCotizacion
  comentario     String?
  createdAt      DateTime          @default(now())
  cotizacion     Cotizacion        @relation(fields: [cotizacionId], references: [id])
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([cotizacionId])
}

model CotizacionItem {
  id           Int                   @id @default(autoincrement())
  cotizacionId Int
  productoId   Int?
  panelId      Int?
  nombre       String?
  cantidad     Float
  medida       Float                 @default(1)
  medidaAncho  Float?
  medidaAlto   Float?
  precio       Float
  subtotal     Float
  descripcion  String?
  adicionales  CotizacionAdicional[]
  cotizacion   Cotizacion            @relation(fields: [cotizacionId], references: [id])
  producto     Producto?             @relation(fields: [productoId], references: [id])
  panel        Panel?                @relation(fields: [panelId], references: [id])
  servicioNetwiseId Int?
  servicioNetwise   ServicioNetwise?   @relation(fields: [servicioNetwiseId], references: [id])
}

// Catálogo de servicios de Netwise (agencia digital): precio de venta directo,
// sin costos ni margen. Separado de Producto (catálogo BTL).
model ServicioNetwise {
  id          Int              @id @default(autoincrement())
  categoria   String
  nombre      String
  descripcion String?
  unidad      String           @default("servicio") // servicio, mes, hora, proyecto, pieza
  precio      Float
  activo      Boolean          @default(true)
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt
  items       CotizacionItem[]

  @@index([categoria])
}

model CotizacionAdicional {
  id               Int               @id @default(autoincrement())
  cotizacionItemId Int
  adicionalId      Int
  seleccionado     Boolean           @default(false)
  precio           Float
  adicional        ProductoAdicional @relation(fields: [adicionalId], references: [id])
  cotizacionItem   CotizacionItem    @relation(fields: [cotizacionItemId], references: [id])
}

model MetaMensual {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  monto     Float
  mes       Int
  anio      Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mes, anio])
  @@index([mes, anio])
}

model MetaMensualLog {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  mes           Int
  anio          Int
  montoAnterior Float?
  montoNuevo    Float
  cambiadoPorId Int
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation("MetaLogVendedor", fields: [usuarioId], references: [id])
  cambiadoPor   Usuario  @relation("MetaLogAdmin", fields: [cambiadoPorId], references: [id])

  @@index([usuarioId, mes, anio])
}

enum TipoMedida {
  UNIDAD
  LINEAL
  AREA
  PESO
}

enum Rol {
  ADMIN
  VENTAS
  CLIENTE
  CONTABLE
}

// Marca con la que se muestra la interfaz al usuario (mismos datos y
// funciones; solo cambia la apariencia).
enum Marca {
  ZAAZMAGO
  NETWISE
}

enum EstadoCotizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  RENEGOCIACION
  FACTURADA
}

enum EstadoPanel {
  LIBRE
  LIBRE_EXTERNO
  OCUPADO
  OCUPADO_EXTERNO
  REEMPLAZO
}

// Si el panel es nuestro o lo gestionamos por cuenta de un tercero (afecta qué
// estados/campos aplican al crear una reserva para ese panel).
enum PropiedadPanel {
  PROPIO
  EXTERNO
}

enum DistritoPanel {
  HUANCAYO
  EL_TAMBO
  CHILCA
}

enum TipoPanel {
  ESTATICO
  LED
  MUPI
}

model Panel {
  id               Int                  @id @default(autoincrement())
  codigo           String               @unique
  nombre           String?
  distrito         DistritoPanel?
  tipo             TipoPanel            @default(ESTATICO)
  ubicacion        String?
  lat              Float?
  lng              Float?
  ancho            Float?
  alto             Float?
  costoProduccion  Float                @default(0)
  costoInstalacion Float                @default(0)
  precioMes        Float?
  estado           EstadoPanel          @default(LIBRE)
  propiedad        PropiedadPanel       @default(PROPIO)
  activo           Boolean              @default(true)
  createdAt        DateTime             @default(now())
  updatedAt        DateTime             @updatedAt
  items            CotizacionItem[]
  reservas         Reserva[]
  parametrosCosto  ParametrosCostoMupi?
}

// Parámetros de costo propios de CADA panel/mupi (varían según tamaño, N° de caras, etc).
model ParametrosCostoMupi {
  id                 Int      @id @default(autoincrement())
  panelId            Int      @unique
  panel              Panel    @relation(fields: [panelId], references: [id])
  luz                Float    @default(100)
  costoHoraManoObra  Float    @default(32)
  horasMantenimiento Float    @default(2)
  horasInstalacion   Float    @default(2)
  costoLona          Float    @default(18)
  anchoLona          Float    @default(1.83)
  altoLona           Float    @default(0.83)
  numeroCaras        Float    @default(2)
  updatedAt          DateTime @updatedAt
}

model Reserva {
  id                Int                           @id @default(autoincrement())
  panelId           Int
  clienteId         Int?
  cotizacionId      Int?
  fechaInicio       DateTime
  fechaFin          DateTime
  precioMensual     Float?
  estado            EstadoPanel                   @default(OCUPADO)
  notas             String?
  activo            Boolean                       @default(true)
  createdAt         DateTime                      @default(now())
  updatedAt         DateTime                      @updatedAt
  panel             Panel                         @relation(fields: [panelId], references: [id])
  cliente           Cliente?                      @relation(fields: [clienteId], references: [id])
  cotizacion        Cotizacion?                   @relation(fields: [cotizacionId], references: [id])
  eventosProduccion EventoProduccionInstalacion[]
}

// Registro de cada trabajo de producción/instalación durante un contrato (el inicial
// y cualquier renovación de banner que pida el cliente). El costo de referencia sale
// de Panel.costoProduccion + Panel.costoInstalacion; aquí solo se registra fecha y
// cuánto se cobró, para saber cuántas veces se renueva y la rentabilidad de ese servicio.
model EventoProduccionInstalacion {
  id           Int      @id @default(autoincrement())
  reservaId    Int
  reserva      Reserva  @relation(fields: [reservaId], references: [id])
  fecha        DateTime
  montoCobrado Float
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EstadoCuota {
  PENDIENTE
  CANCELADO
}

model Proveedor {
  id                  Int                 @id @default(autoincrement())
  nombre              String
  ciudad              String?
  ubicacion           String
  tipoContrato        String
  elementos           String?
  inicio              DateTime
  fin                 DateTime
  costoMensual        Float
  costoLuzMes         Float               @default(0)
  numeroCuenta        String?
  nombreCuenta        String?
  relevanciaComercial String              @default("ALTO")
  razonSocial         String?
  activo              Boolean             @default(true)
  estadoOverride      String?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  cuotas              ProveedorCuota[]
  movimientosAlmacen  MovimientoAlmacen[]
}

model ProveedorCuota {
  id                 Int               @id @default(autoincrement())
  proveedorId        Int
  numero             Int
  monto              Float
  igv                Float
  fecha              String            @default("")
  fechaCobro         DateTime?
  estado             EstadoCuota       @default(PENDIENTE)
  detalle            String?
  // Pago registrado desde Cuentas por pagar (al cancelar la cuota).
  fechaPago          DateTime?
  medioPago          String?
  numeroOperacion    String?
  proveedor          Proveedor         @relation(fields: [proveedorId], references: [id])
  // Caja y Bancos: cuenta de la que salió el pago (registrado desde Cuentas por pagar)
  cuentaFinancieraId Int?
  cuentaFinanciera   CuentaFinanciera? @relation(fields: [cuentaFinancieraId], references: [id])
  montoCuenta        Float?
  tipoCambioCuenta   Float?

  @@index([proveedorId])
  @@index([fechaCobro])
  @@index([cuentaFinancieraId])
}

enum EventoUsuario {
  INVITADO
  REINVITADO
  ACTIVADO
  DESACTIVADO
  ACTIVADO_ADMIN
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  USADA
}

model UsuarioLog {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  evento         EventoUsuario
  realizadoPorId Int?
  createdAt      DateTime      @default(now())
  usuario        Usuario       @relation("LogsDeUsuario", fields: [usuarioId], references: [id])
  realizadoPor   Usuario?      @relation("LogsRealizados", fields: [realizadoPorId], references: [id])

  @@index([usuarioId])
}

model SolicitudMargen {
  id               Int             @id @default(autoincrement())
  usuarioId        Int
  clienteId        Int?
  cotizacionId     Int?
  borradorId       String?
  margenSolicitado Float
  comentario       String
  estado           EstadoSolicitud @default(PENDIENTE)
  aprobadaPorId    Int?
  resolvedAt       DateTime?
  motivoRechazo    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usuario          Usuario         @relation("SolicitudesCreadas", fields: [usuarioId], references: [id])
  aprobadaPor      Usuario?        @relation("SolicitudesResueltas", fields: [aprobadaPorId], references: [id])
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  cotizacion       Cotizacion?     @relation(fields: [cotizacionId], references: [id])
}

enum TipoMovimientoAlmacen {
  ENTRADA
  SALIDA
}

enum TipoItemAlmacen {
  INSUMO
  PRODUCTO_TERMINADO
  // Al principio solo se usaban para Netwise (en BTL/Outdoor estos activos
  // fijos quedaban fuera del Almacén). Desde sep-2026 entran también los de
  // BTL/Outdoor, igual que en el Excel de inventario.
  HERRAMIENTA
  MAQUINARIA_EQUIPO
  MUEBLE_ENSER
}

// Inventario físico real (insumos comprados + productos terminados ya armados),
// separado a propósito del catálogo de Producto que usa Cotizaciones/BTL para
// armar presupuestos — son dos catálogos distintos aunque ambos digan "producto".
// No hay receta/BOM: un producto terminado se registra como entrada manual
// (ya armado), no se descuenta automáticamente de los insumos que llevó.
enum EmpresaItemAlmacen {
  BTL_OUTDOOR
  NETWISE
}

model ItemAlmacen {
  id                  Int                  @id @default(autoincrement())
  codigo              String               @unique
  nombre              String
  tipo                TipoItemAlmacen
  empresa             EmpresaItemAlmacen   @default(BTL_OUTDOOR)
  // Departamento dentro de la empresa (Ventas, Operaciones, Diseño, etc.),
  // tal como viene codificado en el propio código del ítem.
  departamento        String?
  categoria           String
  unidad              String
  ubicacion           String?
  stockMinimo         Float                @default(0)
  stockMaximo         Float                @default(0)
  stockActual         Float                @default(0)
  costoUnitario       Float                @default(0)
  // Texto libre, no una relación a Proveedor: ese modelo es específico de
  // contratos de alquiler de paneles (plazo, costo mensual) y no encaja con
  // "a quién le compramos este insumo" — acá solo es un nombre de referencia.
  proveedorNombre     String?
  // Columna "Observaciones" del Excel de inventario (estado, notas).
  observaciones       String?
  activo              Boolean              @default(true)
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt
  movimientos         MovimientoAlmacen[]
  ordenItems          OrdenAlmacenItem[]
  solicitudes         SolicitudAlmacen[]
  partidasPresupuesto PartidaPresupuesto[]
  // Proveedores propuestos (la regla es tener 3) con su último precio
  proveedores         ItemProveedor[]
  ordenCompraItems    OrdenCompraItem[]

  @@index([tipo])
  @@index([categoria])
  @@index([empresa])
}

enum EstadoSolicitudAlmacen {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Pedido de insumos que llega desde seguimiento-actividades (el botón "Pedir
// insumos al almacén" de un Proyecto) — a diferencia de una salida registrada
// directamente en el ERP, esta NUNCA descuenta stock por sí sola: queda
// PENDIENTE hasta que alguien de Almacén la apruebe o la rechace. Al
// aprobarla recién se crea el MovimientoAlmacen real.
model SolicitudAlmacen {
  id                Int                    @id @default(autoincrement())
  itemAlmacenId     Int
  item              ItemAlmacen            @relation(fields: [itemAlmacenId], references: [id])
  cantidad          Float
  proyectoExternoId String
  proyectoId        Int?
  proyecto          Proyecto?              @relation(fields: [proyectoId], references: [id])
  solicitanteEmail  String?
  notas             String?
  estado            EstadoSolicitudAlmacen @default(PENDIENTE)
  resueltoPorId     Int?
  resueltoPor       Usuario?               @relation(fields: [resueltoPorId], references: [id])
  motivoRechazo     String?
  movimientoId      Int?                   @unique
  movimiento        MovimientoAlmacen?     @relation(fields: [movimientoId], references: [id])
  createdAt         DateTime               @default(now())
  resueltoAt        DateTime?
  // Líneas de órdenes de compra generadas para atender esta solicitud
  ordenCompraItems  OrdenCompraItem[]

  @@index([estado])
  @@index([proyectoExternoId])
}

// Solicitud/picking-list de almacén con varias líneas (como una Cotización
// con varios ítems) — se llena ANTES de sacar o ingresar los materiales,
// se imprime para juntarlos físicamente, y al confirmarse genera un
// MovimientoAlmacen por cada línea. No reemplaza a /entradas ni /salidas
// (que siguen sirviendo para registrar un solo ítem suelto) — es para
// cuando se necesitan varios ítems juntos bajo una sola orden.
model OrdenAlmacen {
  id                Int                   @id @default(autoincrement())
  tipo              TipoMovimientoAlmacen
  ordenServicio     String?
  clienteId         Int?
  cliente           Cliente?              @relation(fields: [clienteId], references: [id])
  proyectoExternoId String?
  proyectoId        Int?
  proyecto          Proyecto?             @relation(fields: [proyectoId], references: [id])
  usuarioId         Int
  usuario           Usuario               @relation(fields: [usuarioId], references: [id])
  notas             String?
  fecha             DateTime              @default(now())
  createdAt         DateTime              @default(now())
  items             OrdenAlmacenItem[]
  movimientos       MovimientoAlmacen[]
  cuentasPorPagar   CuentaPorPagar[]
  // Entrada creada al recibir una orden de compra
  ordenCompraId     Int?
  ordenCompra       OrdenCompra?          @relation(fields: [ordenCompraId], references: [id])

  @@index([tipo])
  @@index([fecha])
  @@index([proyectoId])
  @@index([ordenCompraId])
}

model OrdenAlmacenItem {
  id             Int          @id @default(autoincrement())
  ordenId        Int
  orden          OrdenAlmacen @relation(fields: [ordenId], references: [id])
  itemAlmacenId  Int
  item           ItemAlmacen  @relation(fields: [itemAlmacenId], references: [id])
  cantidad       Float
  precioUnitario Float

  @@index([ordenId])
}

// Kardex de almacén: cada entrada (compra, o ingreso de un producto terminado
// recién armado) o salida (venta a cliente, o consumo de un proyecto de
// seguimiento-actividades) de un ítem. ItemAlmacen.stockActual se mantiene
// denormalizado y se actualiza dentro de la misma transacción que crea el
// movimiento.
model MovimientoAlmacen {
  id                Int                   @id @default(autoincrement())
  tipo              TipoMovimientoAlmacen
  itemAlmacenId     Int
  item              ItemAlmacen           @relation(fields: [itemAlmacenId], references: [id])
  cantidad          Float
  precioUnitario    Float
  precioTotal       Float
  proveedorId       Int?
  proveedor         Proveedor?            @relation(fields: [proveedorId], references: [id])
  clienteId         Int?
  cliente           Cliente?              @relation(fields: [clienteId], references: [id])
  precioFacturado   Float?
  proyectoExternoId String?
  proyectoId        Int?
  proyecto          Proyecto?             @relation(fields: [proyectoId], references: [id])
  usuarioId         Int
  usuario           Usuario               @relation(fields: [usuarioId], references: [id])
  notas             String?
  fecha             DateTime              @default(now())
  createdAt         DateTime              @default(now())
  ordenId           Int?
  orden             OrdenAlmacen?         @relation(fields: [ordenId], references: [id])
  solicitud         SolicitudAlmacen?
  cuentasPorPagar   CuentaPorPagar[]

  @@index([itemAlmacenId])
  @@index([tipo])
  @@index([proveedorId])
  @@index([clienteId])
  @@index([proyectoExternoId])
  @@index([proyectoId])
  @@index([ordenId])
}

enum EstadoProyecto {
  PLANIFICACION
  EN_CURSO
  PAUSADO
  COMPLETADO
  CANCELADO
}

// Proyecto nativo del ERP, nace automáticamente al aprobar una Cotización —
// en paralelo al Proyecto que se crea en Firestore (seguimiento-actividades),
// que sigue existiendo para la gestión de actividades día a día. Este vive
// acá porque necesita responsables reales del ERP y comparar contra el
// Almacén (proyectado vs. asignado), cosa que Firestore no puede ver.
// proyectoFirestoreId guarda el id del documento hermano para poder cruzarlos.
model Proyecto {
  id                   Int                  @id @default(autoincrement())
  nombre               String
  descripcion          String?
  estado               EstadoProyecto       @default(PLANIFICACION)
  // Nulo cuando el Proyecto no nació de una cotización, sino que se creó como
  // "stub" la primera vez que un proyecto de seguimiento-actividades (que no
  // pasó por el ERP) pidió insumos al Almacén — así su consumo también queda
  // registrado y comparable, aunque no tenga cliente ni cotización acá.
  cotizacionId         Int?                 @unique
  cotizacion           Cotizacion?          @relation(fields: [cotizacionId], references: [id])
  clienteId            Int?
  cliente              Cliente?             @relation(fields: [clienteId], references: [id])
  gerenteResponsableId Int?
  gerenteResponsable   Usuario?             @relation("ProyectoGerenteResponsable", fields: [gerenteResponsableId], references: [id])
  jefeResponsableId    Int?
  jefeResponsable      Usuario?             @relation("ProyectoJefeResponsable", fields: [jefeResponsableId], references: [id])
  presupuestoEstimado  Float
  fechaInicio          DateTime
  fechaFin             DateTime
  proyectoFirestoreId  String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt
  ordenes              OrdenAlmacen[]
  movimientos          MovimientoAlmacen[]
  solicitudes          SolicitudAlmacen[]
  presupuesto          PresupuestoProyecto?
  cuentasPorPagar      CuentaPorPagar[]
  ordenesCompra        OrdenCompra[]

  @@unique([proyectoFirestoreId])
  @@index([clienteId])
  @@index([estado])
}

// Catálogo de partidas de la hoja "Presupuesto y control de costos — BTL &
// Producción": las filas que aparecen precargadas al abrir el presupuesto de
// un proyecto. categoria es el código de la sección (MANO_DE_OBRA,
// MATERIALES, PRODUCCION_GRAFICA, LOGISTICA, EQUIPOS, ADMINISTRATIVOS). Si
// tiene itemAlmacenId, el precio sale del costoUnitario de ese ítem en vez de
// precioUnitario — así sigue al Almacén sin mantenerlo a mano.
model PartidaPresupuesto {
  id             Int          @id @default(autoincrement())
  categoria      String
  nombre         String
  unidad         String
  precioUnitario Float        @default(0)
  itemAlmacenId  Int?
  itemAlmacen    ItemAlmacen? @relation(fields: [itemAlmacenId], references: [id], onDelete: SetNull)
  orden          Int          @default(0)
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoria])
}

// Presupuesto guardado de un Proyecto (uno por proyecto). Las filas se copian
// del catálogo al crearlo y desde ahí son propias: cambiar el catálogo no
// altera presupuestos ya guardados.
model PresupuestoProyecto {
  id               Int                       @id @default(autoincrement())
  proyectoId       Int                       @unique
  proyecto         Proyecto                  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  fecha            DateTime?
  responsable      String?
  tipoServicio     String?
  numeroCotizacion String?
  // Porcentaje (45 = 45%). Precio sugerido = costo / (1 - margen/100).
  margen           Float                     @default(45)
  precioNegociado  Float?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  items            PresupuestoProyectoItem[]
}

model PresupuestoProyectoItem {
  id             Int                 @id @default(autoincrement())
  presupuestoId  Int
  presupuesto    PresupuestoProyecto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  categoria      String
  descripcion    String
  unidad         String
  cantidad       Float               @default(0)
  precioUnitario Float               @default(0)
  orden          Int                 @default(0)

  @@index([presupuestoId])
}

// Módulos del menú habilitados por rol (toggles del Admin en Usuarios).
// Sin fila para un rol = todos sus módulos habilitados. Solo aplica a
// VENTAS y CONTABLE; ADMIN siempre ve todo y CLIENTE tiene su propio menú.
model ModulosRol {
  rol       Rol      @id
  modulos   String[]
  updatedAt DateTime @updatedAt
}

// ── Facturación electrónica (SUNAT vía PSE SmartPSE) ──────────────────────
// El ERP arma el XML UBL 2.1, el PSE lo firma y lo envía a SUNAT; aquí se
// guarda el XML firmado y el CDR (constancia de recepción) que devuelve SUNAT.

enum TipoComprobante {
  FACTURA // 01
  BOLETA // 03
  NOTA_CREDITO // 07
  NOTA_DEBITO // 08
}

enum EstadoComprobante {
  PENDIENTE // numerado, aún sin respuesta de SUNAT
  ACEPTADO // CDR de aceptación (puede traer observaciones)
  RECHAZADO // SUNAT lo rechazó: el número queda consumido
  ERROR // falló la comunicación con el PSE; se puede reintentar
}

// Correlativo por serie (F001, B001, FC01, BC01). Se incrementa de forma atómica.
model SerieComprobante {
  serie       String          @id
  tipo        TipoComprobante
  correlativo Int             @default(0)
  updatedAt   DateTime        @updatedAt
}

model Comprobante {
  id                    Int               @id @default(autoincrement())
  tipo                  TipoComprobante
  serie                 String
  correlativo           Int
  fechaEmision          DateTime          @default(now())
  moneda                String            @default("PEN") // PEN | USD
  tipoCambio            Float? // venta SUNAT del día de emisión (solo USD)
  // Receptor (copiado al emitir: el comprobante no cambia si se edita el cliente)
  clienteTipoDoc        String // catálogo 06: 6 RUC, 1 DNI, 0 sin documento
  clienteNumDoc         String
  clienteNombre         String
  clienteDireccion      String?
  valorVenta            Float // total sin IGV
  igv                   Float
  total                 Float
  // Solo notas de crédito/débito: comprobante que modifica y motivo (catálogo 09 / 10)
  referenciaId          Int?
  referencia            Comprobante?      @relation("NotaCredito", fields: [referenciaId], references: [id])
  notasCredito          Comprobante[]     @relation("NotaCredito")
  motivoCodigo          String?
  motivoDescripcion     String?
  observacion           String?
  // Forma de pago (obligatoria en facturas): CONTADO, o CREDITO con cuotas [{ monto, fechaVencimiento }]
  formaPago             String            @default("CONTADO")
  cuotas                Json?
  // Detracción (SPOT): código de bien/servicio (catálogo 54), %, monto y cuenta del Banco de la Nación
  detraccionCodigo      String?
  detraccionPorcentaje  Float?
  detraccionMonto       Float?
  detraccionCuenta      String?
  // El cliente es agente de retención (retiene 3% en facturas sin detracción > S/ 700)
  agenteRetencion       Boolean           @default(false)
  // Cuentas de la empresa impresas en el comprobante (copia al emitir), como en Cotizacion
  cuentasBancarias      Json?
  // ERP: emitido por el PSE. EXTERNO: emitido fuera del ERP (portal SOL) y
  // registrado solo para cobrarlo; no tiene XML/CDR ni se envía a SUNAT.
  origen                String            @default("ERP")
  // Último recordatorio de pago enviado al cliente (Cuentas por cobrar)
  recordatorioEnviadoAt DateTime?
  // Último envío por correo al cliente
  correoEnviadoA        String?
  correoEnviadoAt       DateTime?
  // Última consulta de validez en SUNAT (vía Migo)
  validacionSunat       Json?
  validadoAt            DateTime?
  estado                EstadoComprobante @default(PENDIENTE)
  sunatCodigo           String?
  sunatMensaje          String?
  hash                  String?
  xmlFirmado            String?
  cdrXml                String?
  cotizacionId          Int?
  cotizacion            Cotizacion?       @relation(fields: [cotizacionId], references: [id])
  clienteId             Int?
  cliente               Cliente?          @relation(fields: [clienteId], references: [id])
  usuarioId             Int
  usuario               Usuario           @relation(fields: [usuarioId], references: [id])
  items                 ComprobanteItem[]
  pagos                 PagoComprobante[]
  createdAt             DateTime          @default(now())
  updatedAt             DateTime          @updatedAt

  @@unique([serie, correlativo])
  @@index([cotizacionId])
  @@index([estado])
  @@index([clienteId])
}

model ComprobanteItem {
  id            Int         @id @default(autoincrement())
  comprobanteId Int
  comprobante   Comprobante @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  orden         Int
  descripcion   String
  unidad        String      @default("ZZ") // catálogo 03: ZZ servicio, NIU unidad, MTK m², MTR metro
  cantidad      Float
  valorUnitario Float // sin IGV
  valorVenta    Float // cantidad × valorUnitario
  igv           Float
  afectacionIgv String      @default("10") // catálogo 07: 10 gravado onerosa
}

// Cobros de un comprobante (cuentas por cobrar). COBRO: lo que paga el cliente
// (neto = total − detracción). DETRACCION: depósito del cliente en la cuenta de
// detracciones del Banco de la Nación. RETENCION: 3% que retiene un cliente agente
// de retención (numeroOperacion = n.° del comprobante de retención).
model PagoComprobante {
  id                 Int               @id @default(autoincrement())
  comprobanteId      Int
  comprobante        Comprobante       @relation(fields: [comprobanteId], references: [id], onDelete: Cascade)
  tipo               String            @default("COBRO") // COBRO | DETRACCION | RETENCION
  fecha              DateTime
  monto              Float
  medio              String // TRANSFERENCIA | DEPOSITO | EFECTIVO | YAPE_PLIN | CHEQUE | OTRO
  numeroOperacion    String?
  nota               String?
  usuarioId          Int
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])
  adjuntos           AdjuntoPago[]
  createdAt          DateTime          @default(now())
  // Caja y Bancos: cuenta donde entró/salió el dinero y el monto en la moneda
  // de la cuenta (con tipoCambioCuenta si la moneda del pago es otra).
  cuentaFinancieraId Int?
  cuentaFinanciera   CuentaFinanciera? @relation(fields: [cuentaFinancieraId], references: [id])
  montoCuenta        Float?
  tipoCambioCuenta   Float?

  @@index([comprobanteId])
  @@index([cuentaFinancieraId])
}

// ── Cuentas por pagar ─────────────────────────────────────────────────────
// Proveedores de compras y servicios (imprenta, materiales, transporte…).
// Distinto de Proveedor, que son los arrendadores de paneles con contrato y
// cuotas mensuales; esas cuotas también se muestran en Cuentas por pagar.
model ProveedorCompra {
  id                     Int                     @id @default(autoincrement())
  // RUC (11), DNI (8) o vacío para vendedores informales (notas de venta)
  ruc                    String?                 @unique
  tipoDocIdentidad       String                  @default("RUC") // RUC | DNI | NINGUNO
  razonSocial            String
  nombreComercial        String?
  direccion              String?
  contacto               String?
  telefono               String?
  email                  String?
  banco                  String?
  numeroCuenta           String?
  cci                    String?
  // Condición de pago por defecto al registrar sus facturas
  condicionPago          String                  @default("CONTADO")
  diasCredito            Int?
  // PRODUCTO (mercadería que pasa por almacén) o SERVICIO. afectaComercializacion:
  // su gasto es costo de venta (imprenta, materiales) y no gasto operativo (luz, contador).
  tipo                   String                  @default("PRODUCTO")
  afectaComercializacion Boolean                 @default(true)
  // Categoría de gasto que se precarga al registrar sus documentos
  categoriaGastoId       Int?
  categoriaGasto         CategoriaGasto?         @relation(fields: [categoriaGastoId], references: [id])
  activo                 Boolean                 @default(true)
  createdAt              DateTime                @default(now())
  updatedAt              DateTime                @updatedAt
  cuentas                CuentaPorPagar[]
  // Reparto de sus gastos entre líneas de negocio (los % suman 100 o no hay reparto)
  lineasNegocio          ProveedorLineaNegocio[]
  itemsPropuestos        ItemProveedor[]
  ordenesCompra          OrdenCompra[]
}

// Catálogo editable de líneas de negocio (Outdoor, Impresión…), para repartir
// los gastos de cada proveedor según sus porcentajes.
model LineaNegocio {
  id          Int                     @id @default(autoincrement())
  nombre      String                  @unique
  orden       Int                     @default(0)
  activo      Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  proveedores ProveedorLineaNegocio[]
}

model ProveedorLineaNegocio {
  proveedorId    Int
  proveedor      ProveedorCompra @relation(fields: [proveedorId], references: [id], onDelete: Cascade)
  lineaNegocioId Int
  lineaNegocio   LineaNegocio    @relation(fields: [lineaNegocioId], references: [id])
  porcentaje     Float

  @@id([proveedorId, lineaNegocioId])
  @@index([lineaNegocioId])
}

// Catálogo editable de categorías de gasto, con un nivel de subcategorías
// (Servicios básicos > Luz). El grupo (costo de venta o gasto operativo) se
// define en la categoría principal y lo heredan sus subcategorías.
model CategoriaGasto {
  id          Int               @id @default(autoincrement())
  nombre      String
  grupo       String            @default("GASTO_OPERATIVO") // COSTO_VENTA | GASTO_OPERATIVO
  padreId     Int?
  padre       CategoriaGasto?   @relation("Subcategorias", fields: [padreId], references: [id])
  hijos       CategoriaGasto[]  @relation("Subcategorias")
  orden       Int               @default(0)
  activo      Boolean           @default(true)
  createdAt   DateTime          @default(now())
  cuentas     CuentaPorPagar[]
  proveedores ProveedorCompra[]

  @@index([padreId])
}

// Documento recibido de un proveedor (factura, recibo por honorarios, boleta…)
// que hay que pagar. Se vincula opcionalmente a una entrada de almacén (orden o
// movimiento suelto) y/o a un proyecto: así el gasto real del proyecto sale de
// las facturas de sus proveedores.
model CuentaPorPagar {
  id                  Int                  @id @default(autoincrement())
  proveedorId         Int
  proveedor           ProveedorCompra      @relation(fields: [proveedorId], references: [id])
  tipoDocumento       String               @default("FACTURA") // FACTURA | RECIBO_HONORARIOS | BOLETA | NOTA_DEBITO | NOTA_VENTA | OTRO
  serie               String
  numero              String
  // Correlativo interno de las notas de venta (NV-000123), aunque traigan su propio número
  numeroInterno       String?              @unique
  fechaEmision        DateTime
  moneda              String               @default("PEN")
  tipoCambio          Float?
  valorVenta          Float // base sin IGV
  igv                 Float
  total               Float
  // Detracción que la empresa deposita en la cuenta del proveedor en el Banco
  // de la Nación (en soles) y retención (p. ej. 8% de 4ta categoría en RH).
  detraccionMonto     Float?
  retencionMonto      Float?
  // Categoría antigua (COMPRA | SERVICIO | GASTO_PROYECTO | OTRO); la reemplaza categoriaGasto.
  categoria           String               @default("COMPRA")
  categoriaGastoId    Int?
  categoriaGasto      CategoriaGasto?      @relation(fields: [categoriaGastoId], references: [id])
  // Gasto sin comprobante válido (nota de venta): no da crédito fiscal ni es deducible.
  deducible           Boolean              @default(true)
  // Compra a proveedor de producto: false si la mercadería no pasa por almacén
  // (se entrega directo); así no queda como INGRESO/SALIDA PENDIENTE.
  pasaPorAlmacen      Boolean              @default(true)
  descripcion         String?
  formaPago           String               @default("CONTADO")
  cuotas              Json? // [{ monto, fechaVencimiento }] en crédito; contado vence en la emisión
  proyectoId          Int?
  proyecto            Proyecto?            @relation(fields: [proyectoId], references: [id])
  ordenAlmacenId      Int?
  ordenAlmacen        OrdenAlmacen?        @relation(fields: [ordenAlmacenId], references: [id])
  movimientoAlmacenId Int?
  movimientoAlmacen   MovimientoAlmacen?   @relation(fields: [movimientoAlmacenId], references: [id])
  // Orden de compra que factura este documento (Compras)
  ordenCompraId       Int?
  ordenCompra         OrdenCompra?         @relation(fields: [ordenCompraId], references: [id])
  anulado             Boolean              @default(false)
  usuarioId           Int
  usuario             Usuario              @relation(fields: [usuarioId], references: [id])
  pagos               PagoCuentaPorPagar[]
  adjuntos            AdjuntoPago[]
  createdAt           DateTime             @default(now())
  updatedAt           DateTime             @updatedAt

  @@unique([proveedorId, tipoDocumento, serie, numero])
  @@index([proyectoId])
  @@index([ordenCompraId])
  @@index([fechaEmision])
}

// PAGO: lo que se transfiere al proveedor (neto = total − detracción − retención).
// DETRACCION: depósito en su cuenta del Banco de la Nación (soles).
model PagoCuentaPorPagar {
  id                 Int               @id @default(autoincrement())
  cuentaId           Int
  cuenta             CuentaPorPagar    @relation(fields: [cuentaId], references: [id], onDelete: Cascade)
  tipo               String            @default("PAGO") // PAGO | DETRACCION
  fecha              DateTime
  monto              Float
  medio              String
  numeroOperacion    String?
  nota               String?
  usuarioId          Int
  usuario            Usuario           @relation(fields: [usuarioId], references: [id])
  adjuntos           AdjuntoPago[]
  createdAt          DateTime          @default(now())
  // Caja y Bancos: cuenta donde entró/salió el dinero y el monto en la moneda
  // de la cuenta (con tipoCambioCuenta si la moneda del pago es otra).
  cuentaFinancieraId Int?
  cuentaFinanciera   CuentaFinanciera? @relation(fields: [cuentaFinancieraId], references: [id])
  montoCuenta        Float?
  tipoCambioCuenta   Float?

  @@index([cuentaId])
  @@index([cuentaFinancieraId])
}

// Constancia de un cobro o pago (voucher, captura de Yape, constancia de
// detracción del Banco de la Nación…) o foto de un documento por pagar (nota
// de venta): imagen o PDF guardado en Supabase Storage (bucket privado); se
// descarga con una URL firmada temporal.
model AdjuntoPago {
  id                   Int                 @id @default(autoincrement())
  ruta                 String              @unique // ruta dentro del bucket
  nombre               String // nombre original del archivo
  tipo                 String // MIME
  tamano               Int
  pagoComprobanteId    Int?
  pagoComprobante      PagoComprobante?    @relation(fields: [pagoComprobanteId], references: [id], onDelete: Cascade)
  pagoCuentaPorPagarId Int?
  pagoCuentaPorPagar   PagoCuentaPorPagar? @relation(fields: [pagoCuentaPorPagarId], references: [id], onDelete: Cascade)
  cuentaPorPagarId     Int?
  cuentaPorPagar       CuentaPorPagar?     @relation(fields: [cuentaPorPagarId], references: [id], onDelete: Cascade)
  usuarioId            Int
  usuario              Usuario             @relation(fields: [usuarioId], references: [id])
  createdAt            DateTime            @default(now())

  @@index([pagoComprobanteId])
  @@index([pagoCuentaPorPagarId])
  @@index([cuentaPorPagarId])
}

// ── Caja y Bancos ─────────────────────────────────────────────────────────
// Cuentas de la empresa (bancos, caja, cuenta de detracciones del Banco de la
// Nación, billeteras). Saldo = saldoInicial a fechaSaldoInicial + cobros que
// entraron − pagos que salieron desde esa fecha (no hay movimientos manuales).
model CuentaFinanciera {
  id                Int                  @id @default(autoincrement())
  nombre            String
  tipo              String               @default("BANCO") // BANCO | CAJA | DETRACCIONES | BILLETERA
  banco             String?
  numero            String?
  cci               String?
  moneda            String               @default("PEN") // PEN | USD
  saldoInicial      Float                @default(0)
  fechaSaldoInicial DateTime
  orden             Int                  @default(0)
  activo            Boolean              @default(true)
  createdAt         DateTime             @default(now())
  updatedAt         DateTime             @updatedAt
  cobros            PagoComprobante[]
  pagos             PagoCuentaPorPagar[]
  cuotasPanel       ProveedorCuota[]
}

// ── Compras ───────────────────────────────────────────────────────────────
// Proveedor propuesto para un ítem de almacén (la regla es proponer 3) con su
// último precio unitario sin IGV. Al recibir una orden de compra se actualiza
// el precio del proveedor elegido (origen COMPRA).
model ItemProveedor {
  id            Int             @id @default(autoincrement())
  itemAlmacenId Int
  item          ItemAlmacen     @relation(fields: [itemAlmacenId], references: [id], onDelete: Cascade)
  proveedorId   Int
  proveedor     ProveedorCompra @relation(fields: [proveedorId], references: [id])
  precio        Float
  moneda        String          @default("PEN")
  fechaPrecio   DateTime        @default(now())
  origen        String          @default("MANUAL") // MANUAL | COMPRA
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@unique([itemAlmacenId, proveedorId])
  @@index([proveedorId])
}

// Orden de compra a un proveedor. Flujo: BORRADOR → PENDIENTE (enviada a
// Finanzas) → APROBADA o RECHAZADA → RECIBIDA_PARCIAL → RECIBIDA; o ANULADA.
// Precios sin IGV; se paga vía Cuentas por pagar (documentos vinculados).
model OrdenCompra {
  id                 Int               @id @default(autoincrement())
  numero             String            @unique // OC-000001
  proveedorId        Int
  proveedor          ProveedorCompra   @relation(fields: [proveedorId], references: [id])
  estado             String            @default("BORRADOR")
  moneda             String            @default("PEN")
  tipoCambio         Float?
  condicionPago      String            @default("CONTADO")
  diasCredito        Int?
  fechaEntrega       DateTime?
  proyectoId         Int?
  proyecto           Proyecto?         @relation(fields: [proyectoId], references: [id])
  notas              String?
  valorVenta         Float             @default(0)
  igv                Float             @default(0)
  total              Float             @default(0)
  creadoPorId        Int
  creadoPor          Usuario           @relation("OrdenCompraCreador", fields: [creadoPorId], references: [id])
  enviadaAt          DateTime?
  aprobadoPorId      Int?
  aprobadoPor        Usuario?          @relation("OrdenCompraAprobador", fields: [aprobadoPorId], references: [id])
  aprobadoAt         DateTime?
  comentarioFinanzas String?
  motivoRechazo      String?
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  items              OrdenCompraItem[]
  recepciones        OrdenAlmacen[]
  cuentasPorPagar    CuentaPorPagar[]

  @@index([estado])
  @@index([proveedorId])
}

model OrdenCompraItem {
  id                 Int               @id @default(autoincrement())
  ordenCompraId      Int
  ordenCompra        OrdenCompra       @relation(fields: [ordenCompraId], references: [id], onDelete: Cascade)
  itemAlmacenId      Int
  item               ItemAlmacen       @relation(fields: [itemAlmacenId], references: [id])
  cantidad           Float
  precioUnitario     Float // sin IGV, en la moneda de la orden
  cantidadRecibida   Float             @default(0)
  solicitudAlmacenId Int?
  solicitud          SolicitudAlmacen? @relation(fields: [solicitudAlmacenId], references: [id])

  @@index([ordenCompraId])
  @@index([itemAlmacenId])
  @@index([solicitudAlmacenId])
}
