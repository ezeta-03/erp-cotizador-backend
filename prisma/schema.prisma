generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Configuracion {
  id                        Int      @id @default(autoincrement())
  costo_indirecto           Float    @default(0.10)
  porcentaje_administrativo Float    @default(0.17)
  rentabilidad              Float    @default(0.30)
  updatedAt                 DateTime @updatedAt
}

model Usuario {
  id                Int           @id @default(autoincrement())
  nombre            String
  nombreComercial   String?
  email             String        @unique
  password          String?
  role              Rol
  activo            Boolean       @default(true)
  activationToken   String?       @unique
  activationExpires DateTime?
  createdAt         DateTime      @default(now())
  cliente                  Cliente?
  cotizaciones             Cotizacion[]
  metas                    MetaMensual[]
  solicitudesMargen        SolicitudMargen[]  @relation("SolicitudesCreadas")
  solicitudesResueltas     SolicitudMargen[]  @relation("SolicitudesResueltas")
  cotizacionLogs           CotizacionLog[]
  metaLogs                 MetaMensualLog[] @relation("MetaLogVendedor")
  metaLogsCambios          MetaMensualLog[] @relation("MetaLogAdmin")
  logsComoSujeto           UsuarioLog[]    @relation("LogsDeUsuario")
  logsRealizados           UsuarioLog[]    @relation("LogsRealizados")
  panelWidgets             PanelWidget[]
}

// Acomodo personal del panel de bienvenida (bento): qué bloques tiene cada
// usuario, dónde y de qué tamaño. "kind" identifica el bloque (un módulo como
// "outdoor", o un submódulo puntual como "outdoor.rentabilidad").
model PanelWidget {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  kind      String
  x         Int
  y         Int
  w         Int
  h         Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, kind])
}

model Cliente {
  id              Int          @id @default(autoincrement())
  nombreComercial String
  documento       String       @unique
  nombreContacto  String
  telefono        String?
  email           String?
  direccion       String?
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  usuarioId       Int?         @unique
  usuario         Usuario?     @relation(fields: [usuarioId], references: [id])
  cotizaciones    Cotizacion[]
  reservas        Reserva[]
  solicitudesMargen SolicitudMargen[]
}

model Producto {
  id              Int                 @id @default(autoincrement())
  categoria       String
  servicio        String
  material        String?
  unidad          String?
  costo_material  Float
  costo_parcial_1 Float
  costo_parcial_2 Float
  precio_final    Float
  margen          Float
  activo          Boolean             @default(true)
  origen          String              @default("CSV")
  tipoMedida      TipoMedida          @default(UNIDAD)
  nombre          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           CotizacionItem[]
  adicionales     ProductoAdicional[]

  @@index([categoria])
  @@index([servicio])
}

model ProductoAdicional {
  id         Int                   @id @default(autoincrement())
  nombre     String
  precio     Float
  productoId Int
  items      CotizacionAdicional[]
  producto   Producto              @relation(fields: [productoId], references: [id])
}

model Cotizacion {
  id                  Int              @id @default(autoincrement())
  numero              String           @unique
  total               Float
  conIgv              Boolean          @default(true)
  estado              EstadoCotizacion @default(PENDIENTE)
  createdAt           DateTime         @default(now())
  respondidaAt        DateTime?
  respuestaComentario String?
  facturadaAt         DateTime?
  clienteId           Int
  usuarioId           Int
  cliente             Cliente          @relation(fields: [clienteId], references: [id])
  usuario             Usuario          @relation(fields: [usuarioId], references: [id])
  items               CotizacionItem[]
  log                 CotizacionLog[]
  reservas            Reserva[]
  solicitudesMargen   SolicitudMargen[]
}

model CotizacionLog {
  id             Int               @id @default(autoincrement())
  cotizacionId   Int
  usuarioId      Int
  estadoAnterior EstadoCotizacion?
  estadoNuevo    EstadoCotizacion
  comentario     String?
  createdAt      DateTime          @default(now())
  cotizacion     Cotizacion        @relation(fields: [cotizacionId], references: [id])
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([cotizacionId])
}

model CotizacionItem {
  id           Int                   @id @default(autoincrement())
  cotizacionId Int
  productoId   Int?
  panelId      Int?
  nombre       String?
  cantidad     Float
  medida       Float                 @default(1)
  medidaAncho  Float?
  medidaAlto   Float?
  precio       Float
  subtotal     Float
  descripcion  String?
  adicionales  CotizacionAdicional[]
  cotizacion   Cotizacion            @relation(fields: [cotizacionId], references: [id])
  producto     Producto?             @relation(fields: [productoId], references: [id])
  panel        Panel?                @relation(fields: [panelId], references: [id])
}

model CotizacionAdicional {
  id               Int               @id @default(autoincrement())
  cotizacionItemId Int
  adicionalId      Int
  seleccionado     Boolean           @default(false)
  precio           Float
  adicional        ProductoAdicional @relation(fields: [adicionalId], references: [id])
  cotizacionItem   CotizacionItem    @relation(fields: [cotizacionItemId], references: [id])
}

model MetaMensual {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  monto     Float
  mes       Int
  anio      Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mes, anio])
  @@index([mes, anio])
}

model MetaMensualLog {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  mes           Int
  anio          Int
  montoAnterior Float?
  montoNuevo    Float
  cambiadoPorId Int
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation("MetaLogVendedor", fields: [usuarioId], references: [id])
  cambiadoPor   Usuario  @relation("MetaLogAdmin", fields: [cambiadoPorId], references: [id])

  @@index([usuarioId, mes, anio])
}

enum TipoMedida {
  UNIDAD
  LINEAL
  AREA
  PESO
}

enum Rol {
  ADMIN
  VENTAS
  CLIENTE
  CONTABLE
}

enum EstadoCotizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  RENEGOCIACION
  FACTURADA
}

enum EstadoPanel {
  LIBRE
  LIBRE_EXTERNO
  OCUPADO
  OCUPADO_EXTERNO
  REEMPLAZO
}

// Si el panel es nuestro o lo gestionamos por cuenta de un tercero (afecta qué
// estados/campos aplican al crear una reserva para ese panel).
enum PropiedadPanel {
  PROPIO
  EXTERNO
}

enum DistritoPanel {
  HUANCAYO
  EL_TAMBO
  CHILCA
}

enum TipoPanel {
  ESTATICO
  LED
  MUPI
}

model Panel {
  id               Int            @id @default(autoincrement())
  codigo           String         @unique
  nombre           String?
  distrito         DistritoPanel?
  tipo             TipoPanel      @default(ESTATICO)
  ubicacion        String?
  lat              Float?
  lng              Float?
  ancho            Float?
  alto             Float?
  costoProduccion  Float          @default(0)
  costoInstalacion Float          @default(0)
  precioMes        Float?
  estado           EstadoPanel    @default(LIBRE)
  propiedad        PropiedadPanel @default(PROPIO)
  activo           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            CotizacionItem[]
  reservas         Reserva[]
  parametrosCosto  ParametrosCostoMupi?
}

// Parámetros de costo propios de CADA panel/mupi (varían según tamaño, N° de caras, etc).
model ParametrosCostoMupi {
  id                 Int      @id @default(autoincrement())
  panelId            Int      @unique
  panel              Panel    @relation(fields: [panelId], references: [id])
  luz                Float    @default(100)
  costoHoraManoObra  Float    @default(32)
  horasMantenimiento Float    @default(2)
  horasInstalacion   Float    @default(2)
  costoLona          Float    @default(18)
  anchoLona          Float    @default(1.83)
  altoLona           Float    @default(0.83)
  numeroCaras        Float    @default(2)
  updatedAt          DateTime @updatedAt
}

model Reserva {
  id             Int         @id @default(autoincrement())
  panelId        Int
  clienteId      Int?
  cotizacionId   Int?
  fechaInicio    DateTime
  fechaFin       DateTime
  precioMensual  Float?
  estado         EstadoPanel @default(OCUPADO)
  notas          String?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  panel          Panel         @relation(fields: [panelId], references: [id])
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  cotizacion     Cotizacion?   @relation(fields: [cotizacionId], references: [id])
  eventosProduccion EventoProduccionInstalacion[]
}

// Registro de cada trabajo de producción/instalación durante un contrato (el inicial
// y cualquier renovación de banner que pida el cliente). El costo de referencia sale
// de Panel.costoProduccion + Panel.costoInstalacion; aquí solo se registra fecha y
// cuánto se cobró, para saber cuántas veces se renueva y la rentabilidad de ese servicio.
model EventoProduccionInstalacion {
  id           Int      @id @default(autoincrement())
  reservaId    Int
  reserva      Reserva  @relation(fields: [reservaId], references: [id])
  fecha        DateTime
  montoCobrado Float
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EstadoCuota {
  PENDIENTE
  CANCELADO
}

model Proveedor {
  id                  Int               @id @default(autoincrement())
  nombre              String
  ciudad              String?
  ubicacion           String
  tipoContrato        String
  elementos           String?
  inicio              DateTime
  fin                 DateTime
  costoMensual        Float
  costoLuzMes         Float             @default(0)
  numeroCuenta        String?
  nombreCuenta        String?
  relevanciaComercial String            @default("ALTO")
  razonSocial         String?
  activo              Boolean           @default(true)
  estadoOverride      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  cuotas              ProveedorCuota[]
}

model ProveedorCuota {
  id          Int         @id @default(autoincrement())
  proveedorId Int
  numero      Int
  monto       Float
  igv         Float
  fecha       String      @default("")
  fechaCobro  DateTime?
  estado      EstadoCuota @default(PENDIENTE)
  detalle     String?
  proveedor   Proveedor   @relation(fields: [proveedorId], references: [id])

  @@index([proveedorId])
  @@index([fechaCobro])
}

enum EventoUsuario {
  INVITADO
  REINVITADO
  ACTIVADO
  DESACTIVADO
  ACTIVADO_ADMIN
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  USADA
}

model UsuarioLog {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  evento         EventoUsuario
  realizadoPorId Int?
  createdAt      DateTime      @default(now())
  usuario        Usuario       @relation("LogsDeUsuario", fields: [usuarioId], references: [id])
  realizadoPor   Usuario?      @relation("LogsRealizados", fields: [realizadoPorId], references: [id])

  @@index([usuarioId])
}

model SolicitudMargen {
  id               Int             @id @default(autoincrement())
  usuarioId        Int
  clienteId        Int?
  cotizacionId     Int?
  borradorId       String?
  margenSolicitado Float
  comentario       String
  estado           EstadoSolicitud @default(PENDIENTE)
  aprobadaPorId    Int?
  resolvedAt       DateTime?
  motivoRechazo    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usuario          Usuario         @relation("SolicitudesCreadas", fields: [usuarioId], references: [id])
  aprobadaPor      Usuario?        @relation("SolicitudesResueltas", fields: [aprobadaPorId], references: [id])
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  cotizacion       Cotizacion?     @relation(fields: [cotizacionId], references: [id])
}
