generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Configuracion {
  id                        Int      @id @default(autoincrement())
  costo_indirecto           Float    @default(0.10)
  porcentaje_administrativo Float    @default(0.17)
  rentabilidad              Float    @default(0.30)
  updatedAt                 DateTime @updatedAt
}

model Usuario {
  id                Int           @id @default(autoincrement())
  nombre            String
  nombreComercial   String?
  email             String        @unique
  password          String?
  role              Rol
  activo            Boolean       @default(true)
  activationToken   String?       @unique
  activationExpires DateTime?
  createdAt         DateTime      @default(now())
  cliente                  Cliente?
  cotizaciones             Cotizacion[]
  metas                    MetaMensual[]
  solicitudesMargen        SolicitudMargen[]  @relation("SolicitudesCreadas")
  solicitudesResueltas     SolicitudMargen[]  @relation("SolicitudesResueltas")
  cotizacionLogs           CotizacionLog[]
  metaLogs                 MetaMensualLog[] @relation("MetaLogVendedor")
  metaLogsCambios          MetaMensualLog[] @relation("MetaLogAdmin")
  logsComoSujeto           UsuarioLog[]    @relation("LogsDeUsuario")
  logsRealizados           UsuarioLog[]    @relation("LogsRealizados")
  panelWidgets             PanelWidget[]
  movimientosAlmacen       MovimientoAlmacen[]
  ordenesAlmacen           OrdenAlmacen[]
  proyectosComoGerente     Proyecto[]          @relation("ProyectoGerenteResponsable")
  proyectosComoJefe        Proyecto[]          @relation("ProyectoJefeResponsable")
  solicitudesAlmacenResueltas SolicitudAlmacen[]
}

// Acomodo personal del panel de bienvenida (bento): qué bloques tiene cada
// usuario, dónde y de qué tamaño. "kind" identifica el bloque (un módulo como
// "outdoor", o un submódulo puntual como "outdoor.rentabilidad").
model PanelWidget {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  usuario   Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  kind      String
  x         Int
  y         Int
  w         Int
  h         Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([usuarioId, kind])
}

model Cliente {
  id              Int          @id @default(autoincrement())
  nombreComercial String
  documento       String       @unique
  nombreContacto  String
  telefono        String?
  email           String?
  direccion       String?
  activo          Boolean      @default(true)
  createdAt       DateTime     @default(now())
  usuarioId       Int?         @unique
  usuario         Usuario?     @relation(fields: [usuarioId], references: [id])
  cotizaciones    Cotizacion[]
  reservas        Reserva[]
  solicitudesMargen SolicitudMargen[]
  movimientosAlmacen MovimientoAlmacen[]
  ordenesAlmacen    OrdenAlmacen[]
  proyectos         Proyecto[]
}

model Producto {
  id              Int                 @id @default(autoincrement())
  categoria       String
  servicio        String
  material        String?
  unidad          String?
  costo_material  Float
  costo_parcial_1 Float
  costo_parcial_2 Float
  precio_final    Float
  margen          Float
  activo          Boolean             @default(true)
  origen          String              @default("CSV")
  tipoMedida      TipoMedida          @default(UNIDAD)
  nombre          String?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt
  items           CotizacionItem[]
  adicionales     ProductoAdicional[]

  @@index([categoria])
  @@index([servicio])
}

model ProductoAdicional {
  id         Int                   @id @default(autoincrement())
  nombre     String
  precio     Float
  productoId Int
  items      CotizacionAdicional[]
  producto   Producto              @relation(fields: [productoId], references: [id])
}

model Cotizacion {
  id                  Int              @id @default(autoincrement())
  numero              String           @unique
  total               Float
  conIgv              Boolean          @default(true)
  estado              EstadoCotizacion @default(PENDIENTE)
  createdAt           DateTime         @default(now())
  respondidaAt        DateTime?
  respuestaComentario String?
  facturadaAt         DateTime?
  proyectoExternoId    String?
  proyectoExternoError String?
  clienteId           Int
  usuarioId           Int
  cliente             Cliente          @relation(fields: [clienteId], references: [id])
  usuario             Usuario          @relation(fields: [usuarioId], references: [id])
  items               CotizacionItem[]
  log                 CotizacionLog[]
  reservas            Reserva[]
  solicitudesMargen   SolicitudMargen[]
  proyecto            Proyecto?
}

model CotizacionLog {
  id             Int               @id @default(autoincrement())
  cotizacionId   Int
  usuarioId      Int
  estadoAnterior EstadoCotizacion?
  estadoNuevo    EstadoCotizacion
  comentario     String?
  createdAt      DateTime          @default(now())
  cotizacion     Cotizacion        @relation(fields: [cotizacionId], references: [id])
  usuario        Usuario           @relation(fields: [usuarioId], references: [id])

  @@index([cotizacionId])
}

model CotizacionItem {
  id           Int                   @id @default(autoincrement())
  cotizacionId Int
  productoId   Int?
  panelId      Int?
  nombre       String?
  cantidad     Float
  medida       Float                 @default(1)
  medidaAncho  Float?
  medidaAlto   Float?
  precio       Float
  subtotal     Float
  descripcion  String?
  adicionales  CotizacionAdicional[]
  cotizacion   Cotizacion            @relation(fields: [cotizacionId], references: [id])
  producto     Producto?             @relation(fields: [productoId], references: [id])
  panel        Panel?                @relation(fields: [panelId], references: [id])
}

model CotizacionAdicional {
  id               Int               @id @default(autoincrement())
  cotizacionItemId Int
  adicionalId      Int
  seleccionado     Boolean           @default(false)
  precio           Float
  adicional        ProductoAdicional @relation(fields: [adicionalId], references: [id])
  cotizacionItem   CotizacionItem    @relation(fields: [cotizacionItemId], references: [id])
}

model MetaMensual {
  id        Int      @id @default(autoincrement())
  usuarioId Int
  monto     Float
  mes       Int
  anio      Int
  createdAt DateTime @default(now())
  usuario   Usuario  @relation(fields: [usuarioId], references: [id])

  @@unique([usuarioId, mes, anio])
  @@index([mes, anio])
}

model MetaMensualLog {
  id            Int      @id @default(autoincrement())
  usuarioId     Int
  mes           Int
  anio          Int
  montoAnterior Float?
  montoNuevo    Float
  cambiadoPorId Int
  createdAt     DateTime @default(now())
  usuario       Usuario  @relation("MetaLogVendedor", fields: [usuarioId], references: [id])
  cambiadoPor   Usuario  @relation("MetaLogAdmin", fields: [cambiadoPorId], references: [id])

  @@index([usuarioId, mes, anio])
}

enum TipoMedida {
  UNIDAD
  LINEAL
  AREA
  PESO
}

enum Rol {
  ADMIN
  VENTAS
  CLIENTE
  CONTABLE
}

enum EstadoCotizacion {
  PENDIENTE
  APROBADA
  RECHAZADA
  RENEGOCIACION
  FACTURADA
}

enum EstadoPanel {
  LIBRE
  LIBRE_EXTERNO
  OCUPADO
  OCUPADO_EXTERNO
  REEMPLAZO
}

// Si el panel es nuestro o lo gestionamos por cuenta de un tercero (afecta qué
// estados/campos aplican al crear una reserva para ese panel).
enum PropiedadPanel {
  PROPIO
  EXTERNO
}

enum DistritoPanel {
  HUANCAYO
  EL_TAMBO
  CHILCA
}

enum TipoPanel {
  ESTATICO
  LED
  MUPI
}

model Panel {
  id               Int            @id @default(autoincrement())
  codigo           String         @unique
  nombre           String?
  distrito         DistritoPanel?
  tipo             TipoPanel      @default(ESTATICO)
  ubicacion        String?
  lat              Float?
  lng              Float?
  ancho            Float?
  alto             Float?
  costoProduccion  Float          @default(0)
  costoInstalacion Float          @default(0)
  precioMes        Float?
  estado           EstadoPanel    @default(LIBRE)
  propiedad        PropiedadPanel @default(PROPIO)
  activo           Boolean        @default(true)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  items            CotizacionItem[]
  reservas         Reserva[]
  parametrosCosto  ParametrosCostoMupi?
}

// Parámetros de costo propios de CADA panel/mupi (varían según tamaño, N° de caras, etc).
model ParametrosCostoMupi {
  id                 Int      @id @default(autoincrement())
  panelId            Int      @unique
  panel              Panel    @relation(fields: [panelId], references: [id])
  luz                Float    @default(100)
  costoHoraManoObra  Float    @default(32)
  horasMantenimiento Float    @default(2)
  horasInstalacion   Float    @default(2)
  costoLona          Float    @default(18)
  anchoLona          Float    @default(1.83)
  altoLona           Float    @default(0.83)
  numeroCaras        Float    @default(2)
  updatedAt          DateTime @updatedAt
}

model Reserva {
  id             Int         @id @default(autoincrement())
  panelId        Int
  clienteId      Int?
  cotizacionId   Int?
  fechaInicio    DateTime
  fechaFin       DateTime
  precioMensual  Float?
  estado         EstadoPanel @default(OCUPADO)
  notas          String?
  activo         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  panel          Panel         @relation(fields: [panelId], references: [id])
  cliente        Cliente?      @relation(fields: [clienteId], references: [id])
  cotizacion     Cotizacion?   @relation(fields: [cotizacionId], references: [id])
  eventosProduccion EventoProduccionInstalacion[]
}

// Registro de cada trabajo de producción/instalación durante un contrato (el inicial
// y cualquier renovación de banner que pida el cliente). El costo de referencia sale
// de Panel.costoProduccion + Panel.costoInstalacion; aquí solo se registra fecha y
// cuánto se cobró, para saber cuántas veces se renueva y la rentabilidad de ese servicio.
model EventoProduccionInstalacion {
  id           Int      @id @default(autoincrement())
  reservaId    Int
  reserva      Reserva  @relation(fields: [reservaId], references: [id])
  fecha        DateTime
  montoCobrado Float
  notas        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

enum EstadoCuota {
  PENDIENTE
  CANCELADO
}

model Proveedor {
  id                  Int               @id @default(autoincrement())
  nombre              String
  ciudad              String?
  ubicacion           String
  tipoContrato        String
  elementos           String?
  inicio              DateTime
  fin                 DateTime
  costoMensual        Float
  costoLuzMes         Float             @default(0)
  numeroCuenta        String?
  nombreCuenta        String?
  relevanciaComercial String            @default("ALTO")
  razonSocial         String?
  activo              Boolean           @default(true)
  estadoOverride      String?
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  cuotas              ProveedorCuota[]
  movimientosAlmacen  MovimientoAlmacen[]
}

model ProveedorCuota {
  id          Int         @id @default(autoincrement())
  proveedorId Int
  numero      Int
  monto       Float
  igv         Float
  fecha       String      @default("")
  fechaCobro  DateTime?
  estado      EstadoCuota @default(PENDIENTE)
  detalle     String?
  proveedor   Proveedor   @relation(fields: [proveedorId], references: [id])

  @@index([proveedorId])
  @@index([fechaCobro])
}

enum EventoUsuario {
  INVITADO
  REINVITADO
  ACTIVADO
  DESACTIVADO
  ACTIVADO_ADMIN
}

enum EstadoSolicitud {
  PENDIENTE
  APROBADA
  RECHAZADA
  USADA
}

model UsuarioLog {
  id             Int           @id @default(autoincrement())
  usuarioId      Int
  evento         EventoUsuario
  realizadoPorId Int?
  createdAt      DateTime      @default(now())
  usuario        Usuario       @relation("LogsDeUsuario", fields: [usuarioId], references: [id])
  realizadoPor   Usuario?      @relation("LogsRealizados", fields: [realizadoPorId], references: [id])

  @@index([usuarioId])
}

model SolicitudMargen {
  id               Int             @id @default(autoincrement())
  usuarioId        Int
  clienteId        Int?
  cotizacionId     Int?
  borradorId       String?
  margenSolicitado Float
  comentario       String
  estado           EstadoSolicitud @default(PENDIENTE)
  aprobadaPorId    Int?
  resolvedAt       DateTime?
  motivoRechazo    String?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  usuario          Usuario         @relation("SolicitudesCreadas", fields: [usuarioId], references: [id])
  aprobadaPor      Usuario?        @relation("SolicitudesResueltas", fields: [aprobadaPorId], references: [id])
  cliente          Cliente?        @relation(fields: [clienteId], references: [id])
  cotizacion       Cotizacion?     @relation(fields: [cotizacionId], references: [id])
}

enum TipoMovimientoAlmacen {
  ENTRADA
  SALIDA
}

enum TipoItemAlmacen {
  INSUMO
  PRODUCTO_TERMINADO
  // Al principio solo se usaban para Netwise (en BTL/Outdoor estos activos
  // fijos quedaban fuera del Almacén). Desde sep-2026 entran también los de
  // BTL/Outdoor, igual que en el Excel de inventario.
  HERRAMIENTA
  MAQUINARIA_EQUIPO
  MUEBLE_ENSER
}

// Inventario físico real (insumos comprados + productos terminados ya armados),
// separado a propósito del catálogo de Producto que usa Cotizaciones/BTL para
// armar presupuestos — son dos catálogos distintos aunque ambos digan "producto".
// No hay receta/BOM: un producto terminado se registra como entrada manual
// (ya armado), no se descuenta automáticamente de los insumos que llevó.
enum EmpresaItemAlmacen {
  BTL_OUTDOOR
  NETWISE
}

model ItemAlmacen {
  id            Int                 @id @default(autoincrement())
  codigo        String              @unique
  nombre        String
  tipo          TipoItemAlmacen
  empresa       EmpresaItemAlmacen  @default(BTL_OUTDOOR)
  // Departamento dentro de la empresa (Ventas, Operaciones, Diseño, etc.),
  // tal como viene codificado en el propio código del ítem.
  departamento  String?
  categoria     String
  unidad        String
  ubicacion     String?
  stockMinimo   Float               @default(0)
  stockMaximo   Float               @default(0)
  stockActual   Float               @default(0)
  costoUnitario Float               @default(0)
  // Texto libre, no una relación a Proveedor: ese modelo es específico de
  // contratos de alquiler de paneles (plazo, costo mensual) y no encaja con
  // "a quién le compramos este insumo" — acá solo es un nombre de referencia.
  proveedorNombre String?
  // Columna "Observaciones" del Excel de inventario (estado, notas).
  observaciones String?
  activo        Boolean             @default(true)
  createdAt     DateTime            @default(now())
  updatedAt     DateTime            @updatedAt
  movimientos   MovimientoAlmacen[]
  ordenItems    OrdenAlmacenItem[]
  solicitudes   SolicitudAlmacen[]
  partidasPresupuesto PartidaPresupuesto[]

  @@index([tipo])
  @@index([categoria])
  @@index([empresa])
}

enum EstadoSolicitudAlmacen {
  PENDIENTE
  APROBADA
  RECHAZADA
}

// Pedido de insumos que llega desde seguimiento-actividades (el botón "Pedir
// insumos al almacén" de un Proyecto) — a diferencia de una salida registrada
// directamente en el ERP, esta NUNCA descuenta stock por sí sola: queda
// PENDIENTE hasta que alguien de Almacén la apruebe o la rechace. Al
// aprobarla recién se crea el MovimientoAlmacen real.
model SolicitudAlmacen {
  id                Int                    @id @default(autoincrement())
  itemAlmacenId     Int
  item              ItemAlmacen            @relation(fields: [itemAlmacenId], references: [id])
  cantidad          Float
  proyectoExternoId String
  proyectoId        Int?
  proyecto          Proyecto?              @relation(fields: [proyectoId], references: [id])
  solicitanteEmail  String?
  notas             String?
  estado            EstadoSolicitudAlmacen @default(PENDIENTE)
  resueltoPorId     Int?
  resueltoPor       Usuario?               @relation(fields: [resueltoPorId], references: [id])
  motivoRechazo     String?
  movimientoId      Int?                   @unique
  movimiento        MovimientoAlmacen?     @relation(fields: [movimientoId], references: [id])
  createdAt         DateTime               @default(now())
  resueltoAt        DateTime?

  @@index([estado])
  @@index([proyectoExternoId])
}

// Solicitud/picking-list de almacén con varias líneas (como una Cotización
// con varios ítems) — se llena ANTES de sacar o ingresar los materiales,
// se imprime para juntarlos físicamente, y al confirmarse genera un
// MovimientoAlmacen por cada línea. No reemplaza a /entradas ni /salidas
// (que siguen sirviendo para registrar un solo ítem suelto) — es para
// cuando se necesitan varios ítems juntos bajo una sola orden.
model OrdenAlmacen {
  id                Int                   @id @default(autoincrement())
  tipo              TipoMovimientoAlmacen
  ordenServicio     String?
  clienteId         Int?
  cliente           Cliente?              @relation(fields: [clienteId], references: [id])
  proyectoExternoId String?
  proyectoId        Int?
  proyecto          Proyecto?             @relation(fields: [proyectoId], references: [id])
  usuarioId         Int
  usuario           Usuario               @relation(fields: [usuarioId], references: [id])
  notas             String?
  fecha             DateTime              @default(now())
  createdAt         DateTime              @default(now())
  items             OrdenAlmacenItem[]
  movimientos       MovimientoAlmacen[]

  @@index([tipo])
  @@index([fecha])
  @@index([proyectoId])
}

model OrdenAlmacenItem {
  id             Int          @id @default(autoincrement())
  ordenId        Int
  orden          OrdenAlmacen @relation(fields: [ordenId], references: [id])
  itemAlmacenId  Int
  item           ItemAlmacen  @relation(fields: [itemAlmacenId], references: [id])
  cantidad       Float
  precioUnitario Float

  @@index([ordenId])
}

// Kardex de almacén: cada entrada (compra, o ingreso de un producto terminado
// recién armado) o salida (venta a cliente, o consumo de un proyecto de
// seguimiento-actividades) de un ítem. ItemAlmacen.stockActual se mantiene
// denormalizado y se actualiza dentro de la misma transacción que crea el
// movimiento.
model MovimientoAlmacen {
  id                Int                    @id @default(autoincrement())
  tipo              TipoMovimientoAlmacen
  itemAlmacenId     Int
  item              ItemAlmacen            @relation(fields: [itemAlmacenId], references: [id])
  cantidad          Float
  precioUnitario    Float
  precioTotal       Float
  proveedorId       Int?
  proveedor         Proveedor?             @relation(fields: [proveedorId], references: [id])
  clienteId         Int?
  cliente           Cliente?               @relation(fields: [clienteId], references: [id])
  precioFacturado   Float?
  proyectoExternoId String?
  proyectoId        Int?
  proyecto          Proyecto?              @relation(fields: [proyectoId], references: [id])
  usuarioId         Int
  usuario           Usuario                @relation(fields: [usuarioId], references: [id])
  notas             String?
  fecha             DateTime               @default(now())
  createdAt         DateTime               @default(now())
  ordenId           Int?
  orden             OrdenAlmacen?          @relation(fields: [ordenId], references: [id])
  solicitud         SolicitudAlmacen?

  @@index([itemAlmacenId])
  @@index([tipo])
  @@index([proveedorId])
  @@index([clienteId])
  @@index([proyectoExternoId])
  @@index([proyectoId])
  @@index([ordenId])
}

enum EstadoProyecto {
  PLANIFICACION
  EN_CURSO
  PAUSADO
  COMPLETADO
  CANCELADO
}

// Proyecto nativo del ERP, nace automáticamente al aprobar una Cotización —
// en paralelo al Proyecto que se crea en Firestore (seguimiento-actividades),
// que sigue existiendo para la gestión de actividades día a día. Este vive
// acá porque necesita responsables reales del ERP y comparar contra el
// Almacén (proyectado vs. asignado), cosa que Firestore no puede ver.
// proyectoFirestoreId guarda el id del documento hermano para poder cruzarlos.
model Proyecto {
  id                   Int                 @id @default(autoincrement())
  nombre               String
  descripcion          String?
  estado               EstadoProyecto      @default(PLANIFICACION)
  // Nulo cuando el Proyecto no nació de una cotización, sino que se creó como
  // "stub" la primera vez que un proyecto de seguimiento-actividades (que no
  // pasó por el ERP) pidió insumos al Almacén — así su consumo también queda
  // registrado y comparable, aunque no tenga cliente ni cotización acá.
  cotizacionId         Int?                @unique
  cotizacion           Cotizacion?         @relation(fields: [cotizacionId], references: [id])
  clienteId            Int?
  cliente              Cliente?            @relation(fields: [clienteId], references: [id])
  gerenteResponsableId Int?
  gerenteResponsable   Usuario?            @relation("ProyectoGerenteResponsable", fields: [gerenteResponsableId], references: [id])
  jefeResponsableId    Int?
  jefeResponsable      Usuario?            @relation("ProyectoJefeResponsable", fields: [jefeResponsableId], references: [id])
  presupuestoEstimado  Float
  fechaInicio          DateTime
  fechaFin             DateTime
  proyectoFirestoreId  String?
  createdAt            DateTime            @default(now())
  updatedAt            DateTime            @updatedAt
  ordenes              OrdenAlmacen[]
  movimientos          MovimientoAlmacen[]
  solicitudes          SolicitudAlmacen[]
  presupuesto          PresupuestoProyecto?

  @@index([clienteId])
  @@index([estado])
  @@unique([proyectoFirestoreId])
}

// Catálogo de partidas de la hoja "Presupuesto y control de costos — BTL &
// Producción": las filas que aparecen precargadas al abrir el presupuesto de
// un proyecto. categoria es el código de la sección (MANO_DE_OBRA,
// MATERIALES, PRODUCCION_GRAFICA, LOGISTICA, EQUIPOS, ADMINISTRATIVOS). Si
// tiene itemAlmacenId, el precio sale del costoUnitario de ese ítem en vez de
// precioUnitario — así sigue al Almacén sin mantenerlo a mano.
model PartidaPresupuesto {
  id             Int          @id @default(autoincrement())
  categoria      String
  nombre         String
  unidad         String
  precioUnitario Float        @default(0)
  itemAlmacenId  Int?
  itemAlmacen    ItemAlmacen? @relation(fields: [itemAlmacenId], references: [id], onDelete: SetNull)
  orden          Int          @default(0)
  activo         Boolean      @default(true)
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([categoria])
}

// Presupuesto guardado de un Proyecto (uno por proyecto). Las filas se copian
// del catálogo al crearlo y desde ahí son propias: cambiar el catálogo no
// altera presupuestos ya guardados.
model PresupuestoProyecto {
  id               Int                       @id @default(autoincrement())
  proyectoId       Int                       @unique
  proyecto         Proyecto                  @relation(fields: [proyectoId], references: [id], onDelete: Cascade)
  fecha            DateTime?
  responsable      String?
  tipoServicio     String?
  numeroCotizacion String?
  // Porcentaje (45 = 45%). Precio sugerido = costo / (1 - margen/100).
  margen           Float                     @default(45)
  precioNegociado  Float?
  createdAt        DateTime                  @default(now())
  updatedAt        DateTime                  @updatedAt
  items            PresupuestoProyectoItem[]
}

model PresupuestoProyectoItem {
  id             Int                 @id @default(autoincrement())
  presupuestoId  Int
  presupuesto    PresupuestoProyecto @relation(fields: [presupuestoId], references: [id], onDelete: Cascade)
  categoria      String
  descripcion    String
  unidad         String
  cantidad       Float               @default(0)
  precioUnitario Float               @default(0)
  orden          Int                 @default(0)

  @@index([presupuestoId])
}

// Módulos del menú habilitados por rol (toggles del Admin en Usuarios).
// Sin fila para un rol = todos sus módulos habilitados. Solo aplica a
// VENTAS y CONTABLE; ADMIN siempre ve todo y CLIENTE tiene su propio menú.
model ModulosRol {
  rol       Rol      @id
  modulos   String[]
  updatedAt DateTime @updatedAt
}
